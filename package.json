{
  "name": "port-sentinel-dev",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "build": "node scripts/desktop.mjs build",
    "bindings": "node scripts/desktop.mjs generate",
    "wails:doctor": "node scripts/desktop.mjs doctor",
    "format": "pnpm --dir frontend format",
    "format:check": "pnpm --dir frontend format:check",
    "lint": "node frontend/node_modules/oxlint/bin/oxlint --config frontend/.oxlintrc.json frontend/src scripts",
    "verify": "pnpm --dir frontend install --frozen-lockfile && pnpm format:check && pnpm lint && pnpm --dir frontend typecheck && pnpm --dir frontend test && pnpm --dir frontend build && node scripts/check.mjs"
  }
}
