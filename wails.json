{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "port-sentinel",
  "outputfilename": "port-sentinel",
  "frontend:install": "pnpm install --frozen-lockfile",
  "frontend:build": "pnpm build",
  "frontend:dev:watcher": "pnpm dev",
  "frontend:dev:serverUrl": "auto",
  "postBuildHooks": {"darwin/*":"sh ../../scripts/darwin-icon.sh ${bin}"},
  "info": {
    "companyName": "Port Sentinel",
    "productName": "Port Sentinel",
    "productVersion": "2.0.0",
    "copyright": "Copyright © 2026 Port Sentinel",
    "comments": "MIT License"
  }
}
